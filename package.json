{
  "name": "sola-hannover",
  "version": "0.1.4a",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/setup-env.js development && ng serve",
    "build": "node scripts/setup-env.js production && node scripts/set-base-href.js set && ng build --configuration production && node scripts/set-base-href.js reset",
    "deploy": "npm run build && node scripts/create-package.js",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^20.3.21",
    "@angular/common": "^20.3.21",
    "@angular/compiler": "^20.3.21",
    "@angular/core": "^20.3.21",
    "@angular/forms": "^20.3.21",
    "@angular/platform-browser": "^20.3.21",
    "@angular/platform-browser-dynamic": "^20.3.21",
    "@angular/router": "^20.3.21",
    "@churchtools/churchtools-client": "^1.4.2",
    "@siemens/ngx-datatable": "^25.0.0",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "ngx-bootstrap": "^20.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.21",
    "@angular/build": "^20.3.21",
    "@angular/cli": "^20.3.21",
    "@angular/compiler-cli": "^20.3.21",
    "@ngneat/spectator": "^19.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.1.0",
    "jsdom": "^27.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
